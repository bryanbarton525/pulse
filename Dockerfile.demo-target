FROM golang:1.26 AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/demotarget ./cmd/demotarget
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} go build -trimpath -o /demo-target ./cmd/demotarget

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /demo-target /demo-target
USER 65532:65532
ENTRYPOINT ["/demo-target"]
